{
  "name": "@runtypelabs/mixlayer-ai-provider",
  "version": "0.2.3",
  "description": "AI SDK (Vercel) provider for Mixlayer — open-weight model inference (currently the Qwen 3.5 / 3.6 family) over an OpenAI-compatible endpoint.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:live": "pnpm run build && node scripts/live-matrix.mjs",
    "test:watch": "vitest watch",
    "validate:models": "node scripts/validate-model-list.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.0"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.20.0",
    "ai": "7.0.2",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "mixlayer",
    "qwen",
    "llm",
    "provider",
    "openai-compatible"
  ],
  "author": "Runtype Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runtypelabs/mixlayer-ai-provider.git"
  },
  "homepage": "https://github.com/runtypelabs/mixlayer-ai-provider#readme",
  "bugs": {
    "url": "https://github.com/runtypelabs/mixlayer-ai-provider/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false
}
