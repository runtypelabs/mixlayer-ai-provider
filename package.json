{
  "name": "@runtypelabs/mixlayer-ai-provider",
  "version": "2.3.0",
  "description": "AI SDK (Vercel) provider for Mixlayer — open-weight text and vision model inference over an OpenAI-compatible endpoint.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsrs --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:dist": "node scripts/check-dist.mjs",
    "test:live": "pnpm run build && node scripts/live-matrix.mjs",
    "test:watch": "vitest watch",
    "validate:models": "node scripts/validate-model-list.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build",
    "format:oxfmt": "oxfmt",
    "format:oxfmt:check": "oxfmt --check",
    "lint:oxlint": "oxlint . --max-warnings 0",
    "lint": "pnpm lint:oxlint",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.102",
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@ai-sdk/provider": "^4.0.34"
  },
  "peerDependencies": {
    "ai": "^7.0.146"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "ai": "7.0.153",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsdown": "0.23.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "mixlayer",
    "qwen",
    "vision",
    "multimodal",
    "llm",
    "provider",
    "openai-compatible"
  ],
  "author": "Runtype, Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runtypelabs/mixlayer-ai-provider.git"
  },
  "homepage": "https://github.com/runtypelabs/mixlayer-ai-provider#readme",
  "bugs": {
    "url": "https://github.com/runtypelabs/mixlayer-ai-provider/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false
}
